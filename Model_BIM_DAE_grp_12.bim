            "isHidden": true,
            "sourceColumn": "SalesTerritoryGroup"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/cuzzdpnx5equzo7szet7ohk5ei-ktrujkmhrqmu3j3lebpnroyyhe datawarehouse fabric m\",",
                "    dbo_SalesTerritory = Source{[Schema=\"dbo\",Item=\"SalesTerritory\"]}[Data]",
                "in",
                "    dbo_SalesTerritory"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Regions",
            "levels": [
              {
                "name": "Group",
                "ordinal": 0,
                "column": "Group"
              },
              {
                "name": "Country",
                "ordinal": 1,
                "column": "Country"
              },
              {
                "name": "Region",
                "ordinal": 2,
                "column": "Region"
              }
            ]
          }
        ]
      },
      {
        "name": "Time Intelligence",
        "calculationGroup": {
          "calculationItems": [
            {
              "name": "MTD",
              "description": "Month-to-Date",
              "expression": [
                "CALCULATE(SELECTEDMEASURE(), DATESMTD('Date'[DateKey]))",
                ""
              ]
            },
            {
              "name": "QTD",
              "description": "Quarter-to-Date",
              "expression": [
                "CALCULATE(SELECTEDMEASURE(), DATESQTD('Date'[DateKey]",
                "))",
                ""
              ]
            },
            {
              "name": "YTD",
              "description": "Year-to-Date",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[DateKey]))"
            },
            {
              "name": "PY",
              "description": "Previous Year",
              "expression": "CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[DateKey]))"
            },
            {
              "name": "PY MTD",
              "description": "Previous Year Month-to-Date",
              "expression": [
                "CALCULATE( SELECTEDMEASURE(),DATESMTD(SAMEPERIODLASTYEAR('Date'[DateKey])))",
                "",
                "",
                ""
              ]
            },
            {
              "name": "YoY%",
              "description": "Year-over-Year Percentage",
              "expression": [
                "DIVIDE(CALCULATE( SELECTEDMEASURE() - CALCULATE ( SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[DateKey]) ) ), ",
                "        CALCULATE( SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[DateKey])) ",
                ")",
                ""
              ]
            },
            {
              "name": "Current",
              "expression": "SELECTEDMEASURE()"
            }
          ]
        },
        "columns": [
          {
            "name": "Time Intelligence",
            "dataType": "string",
            "sourceColumn": "Name"
          }
        ],
        "partitions": [
          {
            "name": "CalculationGroup 1",
            "mode": "import",
            "source": {
              "type": "calculationGroup"
            }
          }
        ]
      }
