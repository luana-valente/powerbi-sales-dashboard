        "measures": [
          {
            "name": "DistinctProduct",
            "expression": "DISTINCTCOUNT([ProductKey])",
            "formatString": "0"
          },
          {
            "name": "Cost",
            "expression": "SUM([TotalProductCost])",
            "formatString": "#,0"
          },
          {
            "name": "Sales",
            "expression": "SUM([SalesAmount])",
            "formatString": "#,0",
            "kpi": {
              "targetExpression": "'SalesQuota'[Quota]",
              "targetFormatString": "#,0",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='ResellerSales'[Sales]/'ResellerSales'[_Sales Goal] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<0.9,-1,",
                "\t                If(x<1,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "Measure"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Percentage"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "90"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "100"
                }
              ]
            }
          },
          {
            "name": "Profit",
            "expression": "ResellerSales[Sales]-[Cost]",
            "formatString": "#,0"
          },
          {
            "name": "Profit as %",
            "expression": "DIVIDE([Profit],ResellerSales[Sales])",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Sales YTD (Ordered)",
            "expression": " TOTALYTD(ResellerSales[Sales],'Date'[DateKey])",
            "formatString": "0"
          },
          {
            "name": "Sales YTD (Shipped)",
            "expression": [
              " TOTALYTD(ResellerSales[Sales],'Date'[DateKey],USERELATIONSHIP(ResellerSales[ShipDateKey],'Date'[DateKey]))",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "Order",
            "expression": "SUM(ResellerSales[OrderQuantity])"
          },
          {
            "name": "Order to Shipping",
            "expression": [
              " ",
              "AVERAGEX(",
              "    ResellerSales,",
              "    DATEDIFF(ResellerSales[OrderDateKey], ResellerSales[ShipDateKey], DAY)",
              ")"
            ],
            "formatString": "0.0"
          },
          {
            "name": "DistinctTime2Ship",
            "expression": " DISTINCTCOUNT(ResellerSales[Time to ship])",
            "isHidden": true
          }
        ]
      },
      {
        "name": "SalesPerson",
        "columns": [
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "sourceColumn": "EmployeeKey"
          },
          {
            "name": "SalesTerritoryKey",
            "dataType": "int64",
            "sourceColumn": "SalesTerritoryKey"
          },
          {
            "name": "FirstName",
            "dataType": "string",
            "sourceColumn": "FirstName"
          },
          {
            "name": "LastName",
            "dataType": "string",
            "sourceColumn": "LastName"
          },
          {
            "name": "LoginID",
            "dataType": "string",
            "sourceColumn": "LoginID"
          },
          {
            "type": "calculated",
            "name": "SalesPerson",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "SalesPerson[FirstName] &\" \" & SalesPerson[LastName]"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/cuzzdpnx5equzo7szet7ohk5ei-ktrujkmhrqmu3j3lebpnroyyhe datawarehouse fabric m\",",
                "    dbo_SalesPerson = Source{[Schema=\"dbo\",Item=\"SalesPerson\"]}[Data]",
                "in",
                "    dbo_SalesPerson"
              ]
            }
          }
        ]
      },
      {
        "name": "SalesQuota",
        "columns": [
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "sourceColumn": "EmployeeKey"
          },
          {
            "name": "DateKey",
            "dataType": "dateTime",
            "sourceColumn": "DateKey",
            "formatString": "Short Date",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeShortDatePattern\" />"
              }
            ]
          },
          {
            "name": "SalesAmountQuota",
            "dataType": "double",
            "sourceColumn": "SalesAmountQuota"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/cuzzdpnx5equzo7szet7ohk5ei-ktrujkmhrqmu3j3lebpnroyyhe datawarehouse fabric m\",",
                "    dbo_SalesQuota = Source{[Schema=\"dbo\",Item=\"SalesQuota\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(dbo_SalesQuota,{{\"DateKey\", type datetime}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Quota",
            "expression": [
              " ",
              "VAR TotalTrimestre = ",
              "    CALCULATE(",
              "        SUM(SalesQuota[SalesAmountQuota]), ",
              "        ALLEXCEPT('Date', 'Date'[CalendarYear], 'Date'[CalendarQuarter]),",
              "        USERELATIONSHIP('Date'[DateKey], SalesQuota[DateKey])",
              "    )",
              "",
              "VAR SomaSimples = ",
              "    CALCULATE(",
              "        SUM(SalesQuota[SalesAmountQuota]),",
              "        USERELATIONSHIP('Date'[DateKey], SalesQuota[DateKey])",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        HASONEVALUE('Date'[CalendarMonth]),",
              "        TotalTrimestre / 3,",
              "        SomaSimples",
              "    )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Variance",
            "expression": " [Sales] - [Quota]",
            "formatString": "#,0.00"
          },
          {
            "name": "Variance %",
            "expression": " [Variance] / [Quota]",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "SalesTerritory",
        "columns": [
          {
            "name": "SalesTerritoryKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "SalesTerritoryKey"
          },
          {
            "name": "Region",
